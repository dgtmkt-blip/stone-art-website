{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker/project name Cloudflare shows in the dashboard
  // ("stone-art-website") — if you rename it there, update this to match.
  "name": "stone-art-website",
  "compatibility_date": "2026-09-23",
  // Pure static site — no server-side Worker code, just serve the files
  // Next.js's static export produces in out/.
  "assets": {
    "directory": "./out"
  }
}
